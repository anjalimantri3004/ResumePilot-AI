{
  "manifest_version": 3,
  "name": "ResumePilot AI",
  "version": "1.1.0",
  "description": "Capture Job Descriptions from any career page and send them to ResumePilot AI.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "ResumePilot AI",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}